# Salin ke .env (tidak di-commit). Semua opsional: tanpa key, `npm run tts`
# memakai provider gratis (edge, lalu gtranslate). Isi key untuk cadangan resmi.

# Azure Speech (portal.azure.com -> Speech service, tier F0 gratis)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia

# Google Cloud Text-to-Speech (console.cloud.google.com -> API key, aktifkan Text-to-Speech API)
GOOGLE_TTS_API_KEY=
