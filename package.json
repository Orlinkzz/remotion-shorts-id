{
  "name": "senimankode-shorts",
  "version": "0.1.0",
  "description": "Short-form educational video generator (Reels / TikTok / YouTube Shorts) built on Remotion",
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "transcribe": "node scripts/transcribe.mjs",
    "tts": "node scripts/tts.mjs",
    "test:timing": "node --experimental-strip-types scripts/test-timing.mts",
    "render": "node scripts/render.mjs",
    "gen:templates": "node scripts/gen-template-registry.mjs",
    "schema": "node --experimental-strip-types scripts/gen-schema.mts",
    "validate": "node --experimental-strip-types scripts/validate.mts"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@remotion/animation-utils": "^4.0.0",
    "@remotion/captions": "^4.0.0",
    "@remotion/cli": "^4.0.0",
    "@remotion/effects": "^4.0.540",
    "@remotion/google-fonts": "^4.0.0",
    "@remotion/layout-utils": "^4.0.0",
    "@remotion/media-utils": "^4.0.0",
    "@remotion/zod-types": "^4.0.540",
    "msedge-tts": "2.1.1",
    "prism-react-renderer": "^2.4.1",
    "prismjs": "^1.30.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "^4.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "^4.0.0",
    "@remotion/install-whisper-cpp": "^4.0.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
